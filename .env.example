# Copy this file to `.env` and fill in the values. Bun loads `.env` automatically.

# Telegram bot token from @BotFather (https://t.me/BotFather).
# Optional: if set, users can leave the token field blank in the UI and this is used.
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible API for generating baits. Without it, a built-in fallback is used.
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional server port (default 3000).
# PORT=3000
